{
  "name": "@bs-solutions/bastion-ui-v2",
  "version": "0.1.0",
  "description": "Cross-platform React/React Native UI library based on shadcn and react-native-reusables",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ui",
    "react",
    "react-native",
    "shadcn",
    "nativewind",
    "tailwind",
    "bastion"
  ],
  "files": [
    "dist",
    "src",
    "tailwind-preset.cjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./globals.css": "./dist/styles/globals.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
    "add": "node scripts/add.mjs",
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:native": "tsc -p tsconfig.native.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13"
  },
  "peerDependencies": {
    "@rn-primitives/accordion": ">=1.0.0",
    "@rn-primitives/checkbox": ">=1.0.0",
    "@rn-primitives/dialog": ">=1.0.0",
    "@rn-primitives/dropdown-menu": ">=1.0.0",
    "@rn-primitives/label": ">=1.0.0",
    "@rn-primitives/popover": ">=1.0.0",
    "@rn-primitives/progress": ">=1.0.0",
    "@rn-primitives/radio-group": ">=1.0.0",
    "@rn-primitives/select": ">=1.0.0",
    "@rn-primitives/separator": ">=1.0.0",
    "@rn-primitives/slot": ">=1.0.0",
    "@rn-primitives/switch": ">=1.0.0",
    "@rn-primitives/tabs": ">=1.0.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "lucide-react": ">=0.400.0",
    "lucide-react-native": ">=0.400.0",
    "nativewind": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-screens": ">=3.0.0",
    "tailwind-merge": ">=2.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@rn-primitives/accordion": { "optional": true },
    "@rn-primitives/checkbox": { "optional": true },
    "@rn-primitives/dialog": { "optional": true },
    "@rn-primitives/dropdown-menu": { "optional": true },
    "@rn-primitives/label": { "optional": true },
    "@rn-primitives/popover": { "optional": true },
    "@rn-primitives/progress": { "optional": true },
    "@rn-primitives/radio-group": { "optional": true },
    "@rn-primitives/select": { "optional": true },
    "@rn-primitives/separator": { "optional": true },
    "@rn-primitives/slot": { "optional": true },
    "@rn-primitives/switch": { "optional": true },
    "@rn-primitives/tabs": { "optional": true },
    "react-dom": { "optional": true },
    "react-native": { "optional": true },
    "nativewind": { "optional": true },
    "tailwind-merge": { "optional": true },
    "lucide-react": { "optional": true },
    "lucide-react-native": { "optional": true },
    "react-native-reanimated": { "optional": true },
    "react-native-screens": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.73.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.4",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "^4.3.1",
    "react-native-screens": "^4.25.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.2"
  }
}
